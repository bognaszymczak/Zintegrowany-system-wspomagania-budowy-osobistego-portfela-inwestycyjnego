# Skopiuj ten plik jako `.env` (w katalogu api/) i uzupełnij. Plik .env NIE trafia do repozytorium (.gitignore).

# "dev" włącza /docs (próbnik endpointów) i automatyczne tworzenie tabel przy starcie. Na serwerze ustaw "prod".
APP_ENV=dev

# Baza danych. SQLite = zwykły plik, zero instalacji (do nauki i prezentacji).
DATABASE_URL=sqlite:///./horyzont.db
# PostgreSQL (produkcja):   DATABASE_URL=postgresql+psycopg://uzytkownik:haslo@localhost:5432/horyzont

# Ciasteczko sesji tylko po HTTPS — ustaw true na serwerze z certyfikatem.
COOKIE_SECURE=false
SESSION_DAYS=14

# Adresy, z których przeglądarka może wołać API (po przecinku). W dev front używa proxy Vite, więc to tylko zapas.
CORS_ORIGINS=http://localhost:5173

# Gdy w bazie nie ma danych rynkowych: true = pokaż dane przykładowe (z uczciwym opisem na ekranie), false = błąd 503.
# Na produkcji ustaw false, żeby użytkownik nigdy nie zobaczył danych udawanych jako prawdziwe.
ALLOW_DEMO_DATA=true

# Model oceny ryzyka (ekran 8). Puste = model zastępczy (rozkład t-Studenta). Patrz app/services/risk_model.py.
RISK_MODEL_PATH=

# Klucze do zewnętrznych API — TYLKO tutaj, nigdy w kodzie frontu (zmienne VITE_* są publiczne!).
# Alpha Vantage (notowania ETF): https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=
# FRED (VIX, krzywa rentowności): https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
