# Skopiuj ten plik jako ".env" (w katalogu web/) i dostosuj wartości.
# Uwaga: wszystko z prefiksem VITE_ trafia do przeglądarki i jest PUBLICZNE.
# Nigdy nie wpisuj tutaj kluczy do zewnętrznych API (Alpha Vantage, FMP itd.) —
# trzymaj je w api/.env, po stronie serwera.

# true  = dane z mocków (aplikacja działa bez backendu — idealne do prezentacji). To jest też wartość
#         domyślna, gdy zmiennej nie ma wcale — bez pliku .env aplikacja i tak ruszy na atrapach.
# false = zapytania idą do prawdziwego API (FastAPI). NA SERWERZE PRODUKCYJNYM ZAWSZE USTAW false.
VITE_USE_MOCKS=true

# Prefiks adresów API widziany przez przeglądarkę.
# W trybie dev Vite przekazuje "/api" do backendu (patrz VITE_DEV_API_TARGET).
VITE_API_BASE_URL=/api

# Adres backendu używany przez proxy Vite (tylko `npm run dev`).
VITE_DEV_API_TARGET=http://localhost:8000
